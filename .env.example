# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform JavaScript API Key.
VITE_GOOGLE_MAPS_API_KEY=""

# MICROWORK_TOKEN: Optional Bearer token for MicroWork ERP price sync.
MICROWORK_TOKEN=""

# Cloud SQL (PostgreSQL) Runtime & Migration Environment Variables
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
